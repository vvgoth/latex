%This file sets up the presentation frames (other than the title page).

\mode<presentation>

\setbeamerfont*{frametitle}{}
\setbeamerfont{page number in head/foot}{size=\tiny}

% Frame title
\defbeamertemplate*{frametitle}{metu}[1][]
{
\vskip0cm%
  \begin{beamercolorbox}[wd=\paperwidth,ht=1cm]{frametitle}
  
  \begin{tikzpicture}[
    remember picture,
    overlay,
    shift={([yshift=-2cm]current page.north west)}
  ]

  \useasboundingbox (0,0) rectangle (\the\paperwidth,\the\paperheight);
  \fill[color=white] (0,0) rectangle (\the\paperwidth,\the\paperheight);
  
    \shade[left color=metured,right color=metugray] (0,1) rectangle (6.01,1.05);
    \shade[left color=metugray,right color=metublack] (6,1) rectangle (13,1.05);
    
    \shade[left color=metured,right color=metugray] (0,-7.2) rectangle (6.01,-8);
    \shade[left color=metugray,right color=metublack] (6,-7.2) rectangle (13,-8);
    
    \node[anchor=west, metublack, font=\Large] at (0.75,1.5){\insertframetitle};
    \node[anchor=west, white, font=\tiny] at (0.1,-7.35){\insertinstitute};
    \node[anchor=west] at (9.8,1.5){\includegraphics[scale=0.25]{logos/odtulogo2.png}};
  
  \end{tikzpicture}
  \end{beamercolorbox}
}

