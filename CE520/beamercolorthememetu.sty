\mode<presentation>

%Defining the official colours of METU.
\definecolor{metured}{RGB}{227, 24, 55} %Main Red
\definecolor{metugray}{RGB}{113, 112, 115} %Main Gray
\definecolor{metublack}{RGB}{20, 16, 6} %Main Black

\definecolor{metugreen}{RGB}{0, 130, 101} %Green for the institutes
\definecolor{metubrown}{RGB}{122, 111, 0} %Brown for the schools (Hazırlık etc.)
\definecolor{metublue}{RGB}{0, 92, 171} %Blue for the research centers

% Settings for what should have which colour.
\setbeamercolor*{title page header}{fg=metured}
\setbeamercolor*{author}{fg=metugray}
\setbeamercolor*{date}{fg=metublack}
\setbeamercolor*{enumerate item}{fg=metured}
\setbeamercolor*{itemize item}{fg=metured}
\setbeamercolor*{section in toc}{fg=metublack}
\setbeamercolor*{quotation}{fg=metugray}
\setbeamercolor{navigation symbols}{bg=metublack!5, fg=metugray!25}
\setbeamercolor{page number in head/foot}{fg=white}
\setbeamercolor*{item}{fg=metured}

% Settings for the colours fo the references.
\setbeamercolor{bibliography item}{fg=metublack}
\setbeamercolor*{bibliography entry author}{fg=metublack}
\setbeamercolor*{bibliography entry title}{fg=metublack}
\setbeamercolor*{bibliography entry location}{fg=metublack}
\setbeamercolor*{bibliography entry note}{fg=metublack}
\setbeamercolor*{bibliography number}{fg=metublack}

% Settings for the colours in the blocks.
\setbeamercolor{block title}{bg=metured,fg=white}
\setbeamercolor{block body}{bg=metugray!15,fg=metublack}

\mode
<all>